# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=civicfunds
POSTGRES_USER=civicfunds
POSTGRES_PASSWORD=change-me-locally

# Admin credentials for /api/admin/** (match-review queue, ingestion triggers).
# There is no public user registration in CivicFunds - all funding data is public.
CIVICFUNDS_ADMIN_USERNAME=admin
CIVICFUNDS_ADMIN_PASSWORD=change-me-locally

# AI is OFF by default. The app is fully functional without a key.
CIVICFUNDS_AI_ENABLED=false
CIVICFUNDS_AI_API_KEY=
CIVICFUNDS_AI_BASE_URL=https://api.openai.com/v1
CIVICFUNDS_AI_MODEL=gpt-4o-mini
